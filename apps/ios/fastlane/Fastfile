require "shellwords"
require "base64"
require "tmpdir"
require "fileutils"

default_platform(:ios)

def load_env_file(path)
  return unless File.exist?(path)

  File.foreach(path) do |line|
    stripped = line.strip
    next if stripped.empty? || stripped.start_with?("#")

    key, value = stripped.split("=", 2)
    next if key.nil? || key.empty? || value.nil?

    ENV[key] = value if ENV[key].nil? || ENV[key].strip.empty?
  end
end

platform :ios do
  private_lane :asc_api_key do
    load_env_file(File.join(__dir__, ".env"))

    api_key = nil

    key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    if key_path && !key_path.strip.empty?
      api_key = app_store_connect_api_key(path: key_path)
    else
      p8_path = ENV["ASC_KEY_PATH"]
      if p8_path && !p8_path.strip.empty?
      key_id = ENV["ASC_KEY_ID"]
      issuer_id = ENV["ASC_ISSUER_ID"]
      UI.user_error!("Missing ASC_KEY_ID or ASC_ISSUER_ID for ASC_KEY_PATH auth.") if [key_id, issuer_id].any? { |v| v.nil? || v.strip.empty? }

        api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: p8_path
      )
      else
        key_id = ENV["ASC_KEY_ID"]
        issuer_id = ENV["ASC_ISSUER_ID"]
        key_content = ENV["ASC_KEY_CONTENT"]

        UI.user_error!("Missing App Store Connect API key. Set APP_STORE_CONNECT_API_KEY_PATH (json) or ASC_KEY_PATH (p8) or ASC_KEY_ID/ASC_ISSUER_ID/ASC_KEY_CONTENT.") if [key_id, issuer_id, key_content].any? { |v| v.nil? || v.strip.empty? }

        is_base64 = key_content.include?("BEGIN PRIVATE KEY") ? false : true

        api_key = app_store_connect_api_key(
          key_id: key_id,
          issuer_id: issuer_id,
          key_content: key_content,
          is_key_content_base64: is_base64
        )
      end
    end

    api_key
  end

  desc "Build + upload to TestFlight"
  lane :beta do
    api_key = asc_api_key

    team_id = ENV["IOS_DEVELOPMENT_TEAM"]
    if team_id.nil? || team_id.strip.empty?
      helper_path = File.expand_path("../../scripts/ios-team-id.sh", __dir__)
      if File.exist?(helper_path)
        team_id = sh("bash #{helper_path.shellescape}").strip
      end
    end
    UI.user_error!("Missing IOS_DEVELOPMENT_TEAM (Apple Team ID). Add it to fastlane/.env or export it in your shell.") if team_id.nil? || team_id.strip.empty?

    # Generate the Xcode project from project.yml (xcodegen). The .xcodeproj is not checked in.
    sh("cd .. && xcodegen generate")

    # TestFlight requires monotonically increasing build numbers.
    build_number = ENV["IOS_BUILD_NUMBER"]
    if build_number.nil? || build_number.strip.empty?
      build_number = Time.now.strftime("%Y%m%d%H%M")
    end
    UI.message("Using build number: #{build_number}")

    set_info_plist_value(path: "Sources/Info.plist", key: "CFBundleVersion", value: build_number)
    set_info_plist_value(path: "Tests/Info.plist", key: "CFBundleVersion", value: build_number)

    # For automatic signing, xcodebuild needs either:
    # - an Apple ID account added in Xcode Settings → Accounts, OR
    # - an App Store Connect API authentication key passed via -authenticationKey* flags.
    # We prefer the API key so this can run headless (CI) without interactive login.
    asc_key_id = ENV["ASC_KEY_ID"]
    asc_issuer_id = ENV["ASC_ISSUER_ID"]

    auth_key_path = ENV["ASC_KEY_PATH"]

    # If only ASC_KEY_CONTENT is provided (e.g. CI secret), write it to a temp .p8 file.
    if (auth_key_path.nil? || auth_key_path.strip.empty?)
      key_content = ENV["ASC_KEY_CONTENT"]
      if key_content && !key_content.strip.empty?
        is_base64 = key_content.include?("BEGIN PRIVATE KEY") ? false : true
        decoded = is_base64 ? Base64.decode64(key_content) : key_content
        auth_key_path = File.join(Dir.tmpdir, "AuthKey_#{asc_key_id}.p8")
        File.write(auth_key_path, decoded)
        ENV["ASC_KEY_PATH"] = auth_key_path
      end
    end

    auth_xcargs = ""
    if auth_key_path && !auth_key_path.strip.empty?
      UI.user_error!("Missing ASC_KEY_ID or ASC_ISSUER_ID (required for xcodebuild -authenticationKey* flags).") if [asc_key_id, asc_issuer_id].any? { |v| v.nil? || v.strip.empty? }
      auth_xcargs = "-authenticationKeyPath #{auth_key_path.shellescape} -authenticationKeyID #{asc_key_id.shellescape} -authenticationKeyIssuerID #{asc_issuer_id.shellescape}"
    end

    # NOTE: fastlane gym's export/profile detection is flaky with modern Xcode + automatic signing.
    # We run xcodebuild archive/export directly (with -authenticationKey*) and then upload the .ipa.

    timestamp = Time.now.strftime("%Y-%m-%d %H.%M.%S")
    archive_path = File.expand_path("~/Library/Developer/Xcode/Archives/#{Time.now.strftime("%Y-%m-%d")}/OpenClaw #{timestamp}.xcarchive")

    export_dir = File.join(Dir.tmpdir, "openclaw-export-#{build_number}")
    FileUtils.mkdir_p(export_dir)

    export_options_path = File.join(export_dir, "ExportOptions.plist")
    File.write(
      export_options_path,
      <<~PLIST
        <?xml version=\"1.0\" encoding=\"UTF-8\"?>
        <!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
        <plist version=\"1.0\">
        <dict>
          <key>method</key>
          <string>app-store-connect</string>
          <key>signingStyle</key>
          <string>automatic</string>
          <key>teamID</key>
          <string>#{team_id}</string>
        </dict>
        </plist>
      PLIST
    )

    sh(
      "cd .. && set -o pipefail && xcodebuild " \
      "-scheme OpenClaw -project OpenClaw.xcodeproj " \
      "-destination 'generic/platform=iOS' " \
      "-archivePath #{archive_path.shellescape} " \
      "DEVELOPMENT_TEAM=#{team_id.shellescape} " \
      "-allowProvisioningUpdates #{auth_xcargs} " \
      "clean archive"
    )

    sh(
      "xcodebuild -exportArchive " \
      "-archivePath #{archive_path.shellescape} " \
      "-exportPath #{export_dir.shellescape} " \
      "-exportOptionsPlist #{export_options_path.shellescape} " \
      "-allowProvisioningUpdates #{auth_xcargs}"
    )

    ipa_path = File.join(export_dir, "OpenClaw.ipa")
    UI.user_error!("Expected IPA at #{ipa_path}, but it was not found") unless File.exist?(ipa_path)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload App Store metadata (and optionally screenshots)"
  lane :metadata do
    api_key = asc_api_key

    deliver(
      api_key: api_key,
      force: true,
      skip_screenshots: ENV["DELIVER_SCREENSHOTS"] != "1",
      skip_metadata: ENV["DELIVER_METADATA"] != "1"
    )
  end
end
